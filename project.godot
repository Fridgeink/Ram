; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="R.A.M."
run/main_scene="res://scenes/start_menu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
run/max_fps=80
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://assets/sprites/title.png"
boot_splash/use_filter=false
config/icon="res://portraits/ram.png"

[autoload]

Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"
Global="*res://scenes/global.tscn"
InGameUi="*res://scenes/in_game_ui.tscn"
AudioController="*res://scenes/audio_controller.tscn"
SfxController="*res://scenes/sfx_controller.tscn"

[dialogic]

directories/dch_directory={
"chip": "res://characters/chip.dch",
"ram": "res://characters/ram.dch"
}
directories/dtl_directory={
"tut1": "res://timelines/tut1.dtl"
}
layout/style_list=["res://textbox_styles/portrait_textbox.tres", "res://textbox_styles/glitch_textbox.tres"]
layout/default_style="res://textbox_styles/portrait_textbox.tres"
layout/style_directory={
"": "res://textbox_styles/textbox_portrait.tres",
"textbox_portrait": "res://textbox_styles/textbox_portrait.tres"
}
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.04
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.0
animations/join_default_wait=false
animations/leave_default_length=0.0
animations/leave_default_wait=false
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}
glossary/default_case_sensitive=true
animations/join_default="Instant In"
animations/leave_default="Instant Out"
variables={
"box": false
}
text/input_action="dialogic_default_action"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

[global_group]

Cursor=""

[gui]

theme/custom_font="res://assets/fonts/Born2bSportyV2.ttf"

[input]

